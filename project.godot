; GameExtrakit development and contract-test project. Copy only addons/game_extrakit.
config_version=5

[application]
config/name="GameExtrakit — Service Lab"
run/main_scene="res://demo/service_lab.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1100
window/size/viewport_height=760
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

[editor_plugins]
enabled=PackedStringArray("res://addons/game_extrakit/plugin.cfg")
